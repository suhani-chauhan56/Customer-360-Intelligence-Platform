# CustomerAtlas Environment Configuration Template
# Copy to .env and configure for local or production deployments

# Runtime Environment (development, testing, production)
APP_ENV=production

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Security & Master API Key
CUSTOMERATLAS_API_KEY=ca_live_enterprise_secret_key_demo

# Relational Database Connection (SQLite default, or PostgreSQL in production)
# SQLite: sqlite:///data/customer_atlas.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/customer_atlas
DATABASE_URL=sqlite:///data/customer_atlas.db

# File Storage Paths (optional overrides)
DATA_DIR=data/processed
RAW_DATA_DIR=data/raw
MODELS_DIR=models

# Performance & Caching (TTL in seconds)
CACHE_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_MB=50
MAX_SCATTER_SAMPLE_SIZE=2500

# Localization & Currency
CURRENCY_CODE=BRL
CURRENCY_SYMBOL=R$
