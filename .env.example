# Application Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection String (Optional - falls back gracefully to in-memory feature store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/customer360?retryWrites=true&w=majority

# Frontend API URL (leave blank when running frontend with Vite proxy or deployed to same domain)
VITE_API_URL=/api
